{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent==1.5.3",
        "--python",
        "3.13",
        "--prerelease",
        "allow",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context=gemini",
        "--enable-web-dashboard",
        "False",
        "--open-web-dashboard",
        "False"
      ],
      "timeout": 180000
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@1.4.0",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "timeout": 120000
    },
    "sequential-thinking": {
      "command": "bunx",
      "args": [
        "@modelcontextprotocol/server-sequential-thinking@2025.12.18"
      ],
      "timeout": 120000
    },
    "shadcn": {
      "command": "bunx",
      "args": [
        "shadcn@4.11.0",
        "mcp"
      ],
      "timeout": 120000
    },
    "dart-flutter": {
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "timeout": 120000
    },
    "context7": {
      "command": "bunx",
      "args": [
        "@upstash/context7-mcp@3.2.2"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "timeout": 120000
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users"
      },
      "timeout": 180000
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "timeout": 180000
    },
    "grep": {
      "url": "https://mcp.grep.app",
      "timeout": 180000
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "timeout": 180000,
      "env": {
        "FIGMA_PAT": "${FIGMA_PAT}"
      }
    },
    "openai-docs": {
      "url": "https://developers.openai.com/mcp",
      "timeout": 180000
    }
  }
}
